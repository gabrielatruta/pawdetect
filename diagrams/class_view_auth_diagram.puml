@startuml
title PawDetect — Class Diagram (Auth & Welcome)
left to right direction
skinparam shadowing false
skinparam RoundCorner 10
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 28
skinparam ranksep 32
skinparam PackageStyle rectangle
scale 900 width

package "Shared Widgets" as Shared {
  class CustomAppBar {
    +title : String
    +showProfileIcon : boolean
    +showGuestLanguageIcon : boolean
  }
  class AppLogo {
    +render()
  }
  class AppNameTitle {
    +text : String
  }
  class EmailField {
    +controller : TextEditingController
    +validator()
  }
  class PasswordField {
    +controller : TextEditingController
    +validator()
  }
  class PhoneField {
    +controller : TextEditingController
    +validator()
  }
  class PrimaryButton {
    +text : String
    +onPressed()
  }
  class SecondaryButton {
    +text : String
    +onPressed()
  }
  class ErrorMessage {
    +text : String
  }
  class LocationConsentPopup {
    +show()
  }
}

package "Screens" as Screens {
  class WelcomeScreen <<screen>> { }
  class WelcomeTitle { 
    +text : String 
    }
  class WelcomeDescription { 
    +text : String 
    }
  class WelcomeActions { 
    +login() \n +signup() 
    +continueAsGuest() 
    }

  class LoginScreen <<screen>> { }
  class LoginSubtitle { 
    +text : String 
    }
  class LoginForm { 
    +submit() 
    }
  
  class SignupScreen <<screen>> { }
  class SignupForm { 
    +submit() 
    }
  class NameField { 
    +controller : TextEditingController 
    +validator() 
    }
  class ConfirmPasswordField { 
    +controller : TextEditingController 
    +validator() 
    }

  class ForgotPasswordScreen <<screen>> { }
  class ForgotPasswordForm { 
    +submit() 
    }
}

' -------- Composition: screens own their internal parts
WelcomeScreen "1" *-- "1" WelcomeTitle
WelcomeScreen "1" *-- "1" WelcomeDescription
WelcomeScreen "1" *-- "1" WelcomeActions

LoginScreen  "1" *-- "1" LoginForm
LoginScreen  "1" *-- "0..1" LoginSubtitle
LoginForm    "1" *-- "1" EmailField
LoginForm    "1" *-- "1" PasswordField

SignupScreen "1" *-- "1" SignupForm
SignupScreen "1" *-- "1" NameField
SignupScreen "1" *-- "1" ConfirmPasswordField
SignupForm   "1" *-- "1" NameField
SignupForm   "1" *-- "1" EmailField
SignupForm   "1" *-- "1" PhoneField
SignupForm   "1" *-- "1" PasswordField
SignupForm   "1" *-- "1" ConfirmPasswordField

ForgotPasswordScreen "1" *-- "1" ForgotPasswordForm
ForgotPasswordForm   "1" *-- "1" EmailField

' -------- Aggregation: shared widgets attached to specific screens
LoginScreen  "1" o-- "1" CustomAppBar
SignupScreen "1" o-- "1" CustomAppBar
ForgotPasswordScreen "1" o-- "1" CustomAppBar

WelcomeScreen  "0..1" o-- "1" AppLogo
LoginScreen    "0..1" o-- "1" AppLogo
SignupScreen   "0..1" o-- "1" AppLogo
WelcomeScreen  "0..1" o-- "1" AppNameTitle
LoginScreen    "0..1" o-- "1" AppNameTitle
SignupScreen   "0..1" o-- "1" AppNameTitle

LoginScreen    "0..*" o-- "0..*" PrimaryButton
SignupScreen   "0..*" o-- "0..*" PrimaryButton
ForgotPasswordScreen "0..*" o-- "0..*" PrimaryButton
WelcomeScreen  "0..*" o-- "0..*" SecondaryButton

LoginScreen    "0..*" o-- "0..*" ErrorMessage
SignupScreen   "0..*" o-- "0..*" ErrorMessage
ForgotPasswordScreen "0..*" o-- "0..*" ErrorMessage

' -------- Dependency: transient interaction
LoginForm ..> LocationConsentPopup : shows()

@enduml
