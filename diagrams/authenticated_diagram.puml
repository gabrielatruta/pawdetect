@startuml
title Registered User
top to bottom direction

actor "Registered User" as RU

rectangle "Main Actions" {
  usecase "Sign in" as UC1
  usecase "Reset password" as UC2
  usecase "Explore interactive map" as UC3
  usecase "Open report preview" as UC4
  usecase "View report details" as UC5
  usecase "Submit found/lost pet report" as UC6
  usecase "Set alert zone" as UC7
  usecase "See all reports from alert zone" as UC8
}

rectangle "Additional Features" {
  usecase "Access own reports" as UC9
  usecase "Edit own reports" as UC10
  usecase "Mark report as solved" as UC11
  usecase "Filter all reports" as UC12
  usecase "Edit profile information" as UC13
  usecase "Switch language" as UC14
  usecase "Sign out" as UC15
}

' --- Connections ---
RU -up-> UC1
RU -up-> UC2
RU -up-> UC3
RU -up-> UC4
RU -up-> UC5
RU -up-> UC6
RU -up-> UC7 

RU -down-> UC8
RU -down-> UC9
RU -down-> UC10
RU -down-> UC11
RU -down-> UC12
RU -down-> UC13
RU -down-> UC14
RU -down-> UC15
@enduml
